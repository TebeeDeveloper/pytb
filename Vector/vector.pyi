from array import array
from typing import Self, Iterator

class VectorInt:
    def __init__(self, capacity_or_list: int | list[int]) -> None: ...
    @classmethod
    def from_array(cls, arr: array[int]) -> Self: ...
    @classmethod
    def from_list(cls, ls: list[int]) -> Self: ...
    def push_back(self, val: int) -> Self: ...
    def extendls(self, ls: list[int]) -> None: ...
    def extendarr(self, arr: array[int]) -> None: ...
    def emplace_back(self, val: int) -> Self: ...
    def emplace(self, arr: array[int]) -> Self: ...
    def dot_product(self, other: VectorInt) -> int: ...
    def axpy(self, y: VectorInt, a: int) -> None: ...
    def sort(self) -> None: ...
    def find(self, key: int) -> int: ...
    def count(self, key: int) -> int: ...
    def findall(self, key: int) -> VectorInt: ...
    def sum(self) -> int: ...
    def __len__(self) -> int: ...
    def __getitem__(self, i: int) -> int: ...
    def __setitem__(self, i: int, value: int) -> None: ...
    def __iter__(self) -> Iterator[int]: ...
    def __iadd__(self, other: VectorInt) -> Self: ...
    def __add__(self, other: VectorInt) -> VectorInt: ...
    def __isub__(self, other: VectorInt) -> Self: ...
    def __sub__(self, other: VectorInt) -> VectorInt: ...
    def __imul__(self, other: VectorInt) -> Self: ...
    def __mul__(self, other: VectorInt) -> VectorInt: ...